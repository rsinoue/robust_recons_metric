<!-- Launch file -->
<launch>
  <group>
    <remap from="/rtsp_camera_relay/camera_info" to="/cameraaa/camera_info" />
    <node pkg="image_transport" type="republish" name="republish" output="screen" args="compressed in:=/rtsp_camera_relay/image raw out:=/camera/image_raw"/>
  </group>
</launch>



