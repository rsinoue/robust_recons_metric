<!-- Rosbag Launch file -->
<launch>
  <param name="use_sim_time" value="true" />
  <node pkg="rosbag" type="play" name="rosbag" args="--clock /home/roberto/bagfiles/workstation_2016-08-01-16-43-31.bag --topics /imu/data /imu/mag /pg_15508246/camera_info /pg_15508246/image_raw/compressed /pg_15508246/image_raw/compressed" output="screen">
  <!-- <remap from="/mtk/fix" to="/gps/fix" />  -->
  <!-- <remap from="/rtk/fix" to="/ref/fix" />   -->
  <remap from="/pg_15508246/camera_info" to="/camera/camera_info" />
  <!-- <remap from="/lsd_slam/pose" to="/slam/pose" />  -->
  </node>
  <node pkg="image_transport" type="republish" name="republish" output="screen" args="compressed in:=/pg_15508246/image_raw raw out:=/camera/image_raw">
  </node>

</launch>
