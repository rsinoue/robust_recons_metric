<!-- This will start LSD_SLAM. -->
<launch>
    <!--  -->

    <node name="lsd_slam_viewer" pkg="lsd_slam_viewer" type="viewer" output="screen"/>

    <node name="lsd_slam_core" pkg="lsd_slam_core" type="live_slam" args="/image:=/camera/image_raw /camera_info:=/camera/camera_info " output="screen"/>
</launch>
